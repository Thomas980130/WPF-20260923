<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="飲料訂購系統" Height="480" Width="450" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 標題 -->
        <TextBlock Grid.Row="0" Text="飲料訂購系統" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- 菜單列表 -->
        <StackPanel Grid.Row="1">
            <!-- 品項 1：伯爵紅茶 -->
            <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10" Background="#F9F9F9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="伯爵紅茶" FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="$30" FontSize="18" VerticalAlignment="Center" Foreground="#666666"/>
                    <TextBox x:Name="txtCount1" Grid.Column="2" FontSize="18" Height="35" Text="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 品項 2：波霸奶茶 -->
            <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10" Background="#F9F9F9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="波霸奶茶" FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="$60" FontSize="18" VerticalAlignment="Center" Foreground="#666666"/>
                    <TextBox x:Name="txtCount2" Grid.Column="2" FontSize="18" Height="35" Text="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 品項 3：四季春茶 -->
            <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10" Background="#F9F9F9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="四季春茶" FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="$30" FontSize="18" VerticalAlignment="Center" Foreground="#666666"/>
                    <TextBox x:Name="txtCount3" Grid.Column="2" FontSize="18" Height="35" Text="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 品項 4：百香雙響炮 -->
            <Border BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10" Background="#F9F9F9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="百香雙響炮" FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="$40" FontSize="18" VerticalAlignment="Center" Foreground="#666666"/>
                    <TextBox x:Name="txtCount4" Grid.Column="2" FontSize="18" Height="35" Text="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 送出按鈕 -->
        <Button Grid.Row="2" Content="訂購（送出結帳）" FontSize="20" FontWeight="Bold" Height="50" Margin="0,10,0,0"
                Background="#007ACC" Foreground="White" Click="btnOrder_Click"/>
    </Grid>
</Window>